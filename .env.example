# The Go backend (Animind_Backend_Go). Default: http://127.0.0.1:3001
ANIMIND_BACKEND_URL=http://127.0.0.1:3001
# The website that mints the desktop sign-in bridge token. Default: http://localhost:3000
ANIMIND_SITE_URL=http://localhost:3000
# Directory holding libmpv-2.dll. Default: next to the exe.
ANIMIND_MPV_PATH=mpv

# --- Diagnostics (optional; unset in normal use) ---
# Write the app log here. QML runtime errors otherwise go to the debugger and vanish.
# ANIMIND_UI_LOG=C:/tmp/ui.log
# Frame-level socket tracing.
# ANIMIND_SYNC_TRACE=1

# --- Headless harnesses ---
# --sync-selftest: drive the watch-party socket with no UI.
#   ANIMIND_SELFTEST_BASE, _TOKEN (adk_), _USER, _EPISODE,
#   _JOIN=<code> to join instead of host, _MS (window),
#   _PLAY_DELAY_MS (host: when to press play),
#   _IMPAIR_MS (delay this peer's decision after a broadcast),
#   ANIMIND_SYNC_LATE_DELIVERY_MS (delay delivery of the broadcast instead).
# --exit-after <ms>: start the real UI then shut down — the cheap QML regression check.
# --player-probe <file>: read observed mpv properties.
# ANIMIND_UI_MEDIA, ANIMIND_UI_ROOM_TOKEN, ANIMIND_UI_ROOM_USER, ANIMIND_UI_ROOM_EPISODE:
#   drive the party panel inside the real UI for a rendered screenshot.
